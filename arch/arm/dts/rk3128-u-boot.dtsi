/ {
	aliases {
		mmc0 = &emmc;
		mmc1 = &sdmmc;
	};

	chosen {
		stdout-path = &uart1;
	};
};

&psci {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&dmc {
	u-boot,dm-pre-reloc;
};

&nandc {
	u-boot,dm-pre-reloc;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	nand@0 {
		u-boot,dm-spl;
		reg = <0>;
		nand-ecc-mode = "hw";
		nand-ecc-strength = <16>;
		nand-ecc-step-size = <1024>;
	};
};

&sfc {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&emmc {
	u-boot,dm-pre-reloc;
	default-sample-phase = <0>;
	status = "okay";
};

&sdmmc {
    status = "okay";
    broken-cd;
    supports-sd;
    supports-highspeed;
    cap-sd-highspeed;
    card-detect-delay = <200>;
    max-frequency = <37500000>;
    bus-width = <4>;
	ignore-pm-notify;
	keep-power-in-suspend;
	cd-gpios = <&gpio1 0x11 0x00>;
	cap-mmc-highspeed;
	cap-sd-highspeed;

	max-frequency = <37500000>;
	num-slots = <1>;
dmas = <&pdma 10>;
		dma-names = "rx-tx";
		num-slots = <1>;
	bus-width = <1>;
};

&grf {
	u-boot,dm-pre-reloc;
};

&cru {
	u-boot,dm-pre-reloc;
};

&uart1 {
	clock-frequency = <24000000>;
	u-boot,dm-pre-reloc;
};

&uart2 {
    status = "disabled";
};

&u2phy {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&u2phy_otg {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&usb_otg {
	u-boot,dm-pre-reloc;
	status = "okay";
};
